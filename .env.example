# === SUPABASE (console Supabase -> Project Settings -> API) ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplace-par-ta-cle-anon-publique
# SECRET - ne jamais exposer au navigateur, ne jamais commit sur GitHub public
SUPABASE_SERVICE_ROLE_KEY=remplace-par-ta-cle-service-role-secrete

# === STRIPE (dashboard.stripe.com -> Developers -> API keys) ===
# Utilise les clés "test" (pk_test_/sk_test_) tant que tu n'es pas prêt à vendre réellement
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Généré automatiquement par `stripe listen` en local, ou par Stripe après création du webhook en ligne
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === SITE ===
# URL publique de ton site une fois déployé (ex: https://ungriff.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frais de livraison fixes en euros (utilisés côté serveur, jamais fournis par le client)
SHIPPING_FEE_EUR=4.90
